{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/feedback/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/search/?$",
			"dest": "_render"
		},
		{
			"src": "^/auth/callback/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog/editar/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog/nuevo/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog/?$",
			"dest": "_render"
		},
		{
			"src": "^/destinos/editar/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/destinos/nuevo/?$",
			"dest": "_render"
		},
		{
			"src": "^/destinos/([^/]+?)/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/destinos/?$",
			"dest": "_render"
		},
		{
			"src": "^/favoritos/?$",
			"dest": "_render"
		},
		{
			"src": "^/logout/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}