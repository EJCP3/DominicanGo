---


---

<section
    id="mapa"
    class="relative w-full h-screen pt-14 flex flex-col"
    style="background: linear-gradient(180deg, #e8f4f8 0%, #d4eef7 30%, #e2f0e8 60%, #eef6fa 100%);"
>
    <div
        class="flex-1 relative max-w-[1400px] w-full mx-auto px-4 sm:px-6 flex flex-col"
    >
     
        <div class="flex-1 relative overflow-hidden" id="map-wrapper">
            <!-- Animated Airplane Banner -->
            <div class="plane-animation absolute top-[15%] left-0 z-50 flex items-center pointer-events-none drop-shadow-lg opacity-0">
                <!-- Banner -->
                <div class="bg-base-100/90 backdrop-blur-sm border-2 border-base-200 text-base-content px-5 py-2 shadow-sm rounded-sm font-heading font-extrabold uppercase tracking-[0.15em] text-xs sm:text-sm relative ml-4">
                    ¡Haz Clic en algunas provincias y Explora!
                </div>
                <!-- String -->
                <svg class="w-10 sm:w-16 h-4 ml-[-2px] text-base-content/40" viewBox="0 0 100 20" preserveAspectRatio="none">
                    <path d="M0,10 Q50,20 100,10" fill="none" stroke="currentColor" stroke-width="2"/>
                </svg>
                <!-- Plane SVG -->
                <svg class="w-8 h-8 sm:w-10 sm:h-10 text-primary -ml-2 shrink-0" style="transform: rotate(90deg);" viewBox="0 0 24 24" fill="currentColor">
                     <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/>
                </svg>
            </div>

            <div class="map-container w-full h-full" id="map-container">
                <div
                    id="province-tooltip"
                    class="fixed pointer-events-none z-50 opacity-0 transition-opacity duration-200 px-4 py-2 rounded-xl bg-base-100/95 backdrop-blur-md border border-base-200 shadow-lg text-sm font-heading font-semibold text-base-content"
                >
                    <span id="tooltip-text"></span>
                </div>

                <svg
                    viewBox="0 0 960 500"
                    class="w-full h-full"
                    id="rd-map"
                    xmlns="http://www.w3.org/2000/svg"
                    preserveAspectRatio="xMidYMid meet"
                >
                    <text
                        id="map-loading"
                        x="480"
                        y="250"
                        class="text-[14px] font-heading pointer-events-none"
                        fill="#94a3b8"
                        text-anchor="middle">Cargando mapa...</text
                    >

                    <text
                        x="620"
                        y="50"
                        class="text-[11px] italic font-body pointer-events-none tracking-[0.3em] uppercase"
                        fill="#a3c9d9"
                        text-anchor="middle">Océano Atlántico</text
                    >
                    <text
                        x="400"
                        y="470"
                        class="text-[11px] italic font-body pointer-events-none tracking-[0.3em] uppercase"
                        fill="#a3c9d9"
                        text-anchor="middle">Mar Caribe</text
                    >

                    <g id="provinces-group"></g>
                    <g id="labels-group"></g>
                    <g id="overlays-group"></g>

                    <g
                        transform="translate(830, 400)"
                        class="pointer-events-none"
                    >
                        <g id="map-compass">
                            <circle
                                cx="0"
                                cy="0"
                                r="18"
                                fill="none"
                                stroke="#b8ccd6"
                                stroke-width="1"></circle>
                            <circle cx="0" cy="0" r="2" fill="#b8ccd6"></circle>
                            <line
                                x1="0"
                                y1="-14"
                                x2="0"
                                y2="-6"
                                stroke="#b8ccd6"
                                stroke-width="1.5"></line>
                            <line
                                x1="0"
                                y1="6"
                                x2="0"
                                y2="14"
                                stroke="#b8ccd6"
                                stroke-width="1"></line>
                            <line
                                x1="-14"
                                y1="0"
                                x2="-6"
                                y2="0"
                                stroke="#b8ccd6"
                                stroke-width="1"></line>
                            <line
                                x1="6"
                                y1="0"
                                x2="14"
                                y2="0"
                                stroke="#b8ccd6"
                                stroke-width="1"></line>
                            <polygon points="0,-14 -3,-8 3,-8" fill="#b8ccd6"
                            ></polygon>
                        </g>
                    </g>
                </svg>
            </div>
        </div>

        
        <div
            id="hint-bar"
            class="flex items-center justify-center pb-28 md:pb-4 pt-2 relative z-10"
        >
            <div
                class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-base-100/90 backdrop-blur-sm border border-base-200 shadow-sm text-sm text-base-content/70 transition-all"
            >
                <span class="w-2 h-2 rounded-full bg-info animate-pulse"></span>

                <span
                    class="overflow-hidden h-5 inline-flex flex-col relative font-medium text-rotate animate-text-slide duration-15000"
                >
                    <span class="animate-text-slide flex flex-col items-start">
                        <span class="h-5 flex items-center"
                            >Haz clic en una provincia</span
                        >
                        <span class="h-5 flex items-center"
                            >Descubre lugares únicos</span
                        >
                        <span class="h-5 flex items-center"
                            >Planifica tu aventura</span
                        >
                        <span class="h-5 flex items-center"
                            >Encuentra tu destino</span
                        >
                        <span class="h-5 flex items-center"
                            >Explora el paraíso</span
                        >
                    </span>
                </span>
            </div>
        </div>
    </div>

</section>

<style>
@keyframes fly-banner {
    0% { transform: translateX(-110%) translateY(20px) rotate(8deg); opacity: 0; }
    10% { opacity: 1; }
    50% { transform: translateX(40vw) translateY(-30px) rotate(-2deg); }
    90% { opacity: 1; }
    100% { transform: translateX(120vw) translateY(50px) rotate(8deg); opacity: 0; }
}
.plane-animation {
    /* Retrasamos 1s el inicio y la animación de vuelo cruza la pantalla en 12s */
    animation: fly-banner 20s cubic-bezier(0.25, 0.1, 0.25, 1) 1s forwards;
    will-change: transform, opacity;
}
</style>


<script>
    // 1. Importamos SOLO Panzoom (nada de map-renderer aquí)
    import Panzoom from '@panzoom/panzoom';

    function initPanzoom() {
        const svgElement = document.getElementById('rd-map');
        const container = document.getElementById('map-container');

        if (!svgElement || !container) return;

        // 2. Activamos el Zoom interactivo en el SVG
        const panzoom = Panzoom(svgElement, {
            maxScale: 6,
            minScale: 1, 
            contain: 'outside',
            step: 0.3
        });

        // 3. Habilitar zoom con rueda del ratón
        // container.addEventListener('wheel', panzoom.zoomWithWheel);

        // 4. Cambiar el cursor al arrastrar
        svgElement.addEventListener('panzoomstart', () => {
            container.classList.remove('cursor-grab');
            container.classList.add('cursor-grabbing');
        });

        svgElement.addEventListener('panzoomend', () => {
            container.classList.remove('cursor-grabbing');
            container.classList.add('cursor-grab');
        });
    }

    // Inicializar de forma segura con Astro
    document.addEventListener('astro:page-load', initPanzoom);
    
    // Por si acaso carga directo
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
        initPanzoom();
    } else {
        window.addEventListener('DOMContentLoaded', initPanzoom);
    }
</script>
