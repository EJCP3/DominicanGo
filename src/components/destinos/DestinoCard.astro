---
import { Image } from "astro:assets";
import { TIPOS, TYPE_LABELS, ICONS } from "@/data/poi-config.ts";

interface DestinoItem {
    name: string;
    description: string;
    type: string;
    price: string;
    tags?: string[];
    image: string;
    images?: string[];
    province: string;
    provinceSlug: string;
    poiSlug: string;
    provinceColor: string;
    region: string;
    href: string;
    id?: string;
}
interface Props {
    d: DestinoItem;
    token?: string;
    initialFavorited?: boolean;
}
const { d, token = "", initialFavorited = false } = Astro.props;
---

<article
    class="destino-card relative group block rounded-2xl z-10 hover:z-50 shadow-base hover:shadow-2xl transition duration-300"
    data-name={d.name.toLowerCase()}
    data-description={d.description.toLowerCase()}
    data-tipo={d.type}
    data-provincia={d.provinceSlug}
    data-region={d.region}
    data-precio={d.price}
    data-tags={(d.tags ?? []).join(",")}
    data-href={d.href}
    data-modal-name={d.name}
    data-modal-desc={d.description}
    data-modal-province={d.province}
    data-modal-province-color={d.provinceColor}
    data-modal-region={d.region}
    data-modal-price={d.price}
    data-modal-type={d.type}
    data-modal-image={d.image}
    data-modal-images={d.images
        ? [d.image, ...d.images.filter((img: string) => img !== d.image)].join(
              ",",
          )
        : ""}
    data-modal-tags={(d.tags ?? []).join(",")}
>
    <!-- Full clickable link overlay -->
    <a href={d.href} class="absolute inset-0 z-30" aria-label={`Ver destino: ${d.name}`}></a>

    <!-- Image section (takes up most of the card) -->
    <div
        class="relative h-56 sm:h-64 bg-base-300 overflow-hidden rounded-t-2xl"
        transition:name={`img-destino-${d.provinceSlug}-${d.poiSlug}`}
    >
        <figure class="w-full h-full m-0">
            <Image
                src={d.image}
                alt={d.name}
                width={500}
                height={400}
                widths={[300, 500, 800]}
                sizes="(max-width: 640px) 300px, (max-width: 1024px) 500px, 800px"
                format="webp"
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
            />
        </figure>

        <!-- Gradient overlay for hover content -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

        <!-- Type badge (top-left) -->
        <div class="absolute top-3 left-3 z-10 flex gap-1.5">
            <span
                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wide bg-white/20 backdrop-blur-md text-white border border-white/15 shadow-sm card-type-badge"
                data-type={d.type}
            >
                <span
                    class="w-3.5 h-3.5 card-icon flex items-center justify-center shrink-0"
                    set:html={ICONS[d.type]}
                />
                {TYPE_LABELS[d.type] ?? d.type}
            </span>
        </div>

        <!-- Price badge (top-right) -->
        <div class="absolute top-3 right-3 z-10">
            <span
                class={`inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wide backdrop-blur-md shadow-sm border ${d.price === "gratis" ? "bg-emerald-500/25 text-white border-emerald-400/20" : "bg-amber-500/25 text-white border-amber-400/20"}`}
            >
                {d.price === "gratis" ? "GRATIS" : "PAGADO"}
            </span>
        </div>

        <!-- Hover overlay: just a subtle gradient, no text -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
    </div>

    <!-- Info below image -->
    <div class="p-3 bg-base-100">
        <div class="flex items-center gap-2 mb-1">
            <span
                class="w-2 h-2 rounded-full shrink-0"
                style={`background:${d.provinceColor}`}></span>
            <span
                class="text-[11px] font-semibold text-base-content/50 uppercase tracking-wider"
                >{d.province}</span
            >
            <span class="text-[11px] text-base-content/30">·</span>
            <span class="text-[11px] text-base-content/40">{d.region}</span>
        </div>
        <h3
            class="font-heading font-bold text-base-content text-[15px] leading-tight group-hover:text-primary transition-colors line-clamp-1"
        >
            {d.name}
        </h3>

        <!-- Description + tags: visible on hover, drops down smoothly -->
        <div class="card-details absolute left-0 right-0 bottom-0 translate-y-[80%] group-hover:translate-y-full bg-base-100 rounded-b-2xl px-3 pb-3 opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto transition-all duration-300 ease-out z-40 shadow-xl border border-t-0 border-base-content/10">
            <div class="overflow-hidden">
                <p class="text-base-content/60 text-xs leading-relaxed line-clamp-2 mt-2">
                    {d.description}
                </p>
                <div class="flex flex-wrap items-center gap-1.5 mt-2">
                    {
                        (d.tags ?? [])
                            .slice(0, 3)
                            .map((tag: string) => (
                                <span class="px-2 py-0.5 rounded-full bg-base-200 text-base-content/60 text-[10px] font-medium">
                                    {tag}
                                </span>
                            ))
                    }
                </div>
            </div>
        </div>
    </div>
</article>

<style>
    .line-clamp-1 {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .card-icon :global(svg) {
        width: 100%;
        height: 100%;
    }
</style>
