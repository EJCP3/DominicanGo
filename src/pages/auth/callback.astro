---
// /auth/callback — Receives JWT from backend and saves it as a cookie
const token = Astro.url.searchParams.get("token");

if (!token) {
    return Astro.redirect("/?error=auth_failed");
}

// Save the JWT as an HTTP cookie (1 day)
Astro.cookies.set("auth_token", token, {
    path: "/",
    domain: "45.90.237.199.sslip.io",
    maxAge: 60 * 60 * 24 * 1, // 1 día
    httpOnly: false, // false para que los componentes Vue puedan leerla con document.cookie
    sameSite: "lax", // lax funciona cuando el backend redirige al frontend (navegación top-level)
    secure: false, // false porque corremos HTTP sin SSL en el VPS por ahora
});

// data-astro-reload forces a full server-side reload so the Header SSR re-reads the cookie
return Astro.redirect("/", 302);
---
