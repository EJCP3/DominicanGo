---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/layout/Header.astro";
import BlogFiltersPanel from "@/components/blog/BlogFiltersPanel.astro";
import Pagination from "@/components/ui/Pagination.astro";

import { getBlogs, getFavoriteIds } from "@/services/api";

const token = Astro.cookies.get("auth_token")?.value ?? "";
const isLoggedIn = !!token;

// Handle Pagination and Filters from search params
const page = Number(Astro.url.searchParams.get("page") || 1);
const currentCategory = Astro.url.searchParams.get("category") || undefined;
const search = Astro.url.searchParams.get("search") || undefined;

// Parallelize API calls to improve load times
const [
    { blogIds: favBlogIds },
    { data: posts, meta, success, message = "" }
] = await Promise.all([
    getFavoriteIds(token),
    getBlogs({ 
        category: currentCategory, 
        search, 
        page, 
        limit: 9 // Show 9 blogs per page to fill the 3x3 grid perfectly
    })
]);
---

<Layout
    title="Blog de Viajeros — DominicanGo"
    description="Descubre increíbles historias de viajeros explorando la República Dominicana y comparte la tuya."
>
    <Header />

    <main class="min-h-screen pt-24 pb-16">
        <div class="max-w-[1400px] mx-auto px-4 sm:px-6">
            <!-- Hero / Header Section -->
            <section
                class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12"
                aria-label="Introducción del Blog"
            >
                <div>
                    <h1
                        class="font-heading font-extrabold text-4xl md:text-5xl text-base-content mb-3"
                    >
                        Diarios de <span class="text-primary">Viaje</span>
                    </h1>
                    <p class="text-base-content/70 max-w-2xl text-lg">
                        Historias auténticas, guías detalladas y narrativas
                        visuales de exploradores descubriendo cada rincón de
                        República Dominicana.
                    </p>
                </div>
                {
                    isLoggedIn && (
                        <a
                            transition:name="blog-title"
                            href="/blog/nuevo"
                            class="btn btn-primary rounded-full shadow-lg shrink-0"
                        >
                            <svg
                                class="w-5 h-5 mr-1"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 4v16m8-8H4"
                                />
                            </svg>
                            Comparte tu experiencia
                        </a>
                    )
                }
            </section>

            <!-- Categories / Filter (Vue component handles its own trigger) -->
            <section class="flex items-center gap-4 mb-10" aria-label="Filtros del Blog">
                <div class="relative z-50">
                    <BlogFiltersPanel />
                </div>
            </section>

            <!-- Blog Grid (Bento Style) -->
            {posts && posts.length > 0 ? (
                <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 grid-flow-row-dense gap-6" aria-label="Lista de Artículos">
                    {
                        posts.map((post: any) => {
                        const isMainColor = !post.color?.startsWith('base-');
                        const cardBgClass = post.color ? `bg-${post.color}` : 'bg-base-100';
                        const cardTextClass = isMainColor ? `text-${post.color}-content` : 'text-base-content';
                        const borderColor = isMainColor ? `border-${post.color}/20` : 'border-base-200';
                        
                        return (
                        <article class={`card ${cardBgClass} ${cardTextClass} ${post.size || 'col-span-1'} shadow-sm border ${borderColor} hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden group relative`}>
                            <!-- Overlay link to make the entire article clickable without invalid nested links -->
                            <a href={`/blog/${post.slug}`} aria-label={`Leer artículo: ${post.title}`} class="absolute inset-0 z-20 w-full h-full cursor-pointer"></a>
                            
                            <figure class={`overflow-hidden relative bg-base-300 ${post.size?.includes('row-span-2') ? 'h-full min-h-[300px]' : 'aspect-video'}`}>
                                <img
                                    src={post.images[0]}
                                    alt={post.title}
                                    loading={posts.indexOf(post) < 3 ? "eager" : "lazy"}
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                    transition:name={`img-blog-${post.slug}`}
                                />
                                <div class="absolute top-4 left-4 bg-base-100/90 backdrop-blur-sm px-3 py-1 rounded-full text-[10px] font-bold tracking-widest uppercase text-primary shadow-sm z-30">
                                    {post.category}
                                </div>
                            </figure>
                            
                            <div class={`card-body p-6 ${post.size?.includes('row-span-2') ? 'absolute bottom-0 inset-x-0 bg-linear-to-t from-black/80 via-black/40 to-transparent text-white pt-20' : ''}`}>
                                <h2
                                    transition:name={`title-blog-${post.slug}`}
                                    class={`card-title font-heading font-bold text-xl leading-tight mb-2 group-hover:text-primary transition-colors ${post.size?.includes('row-span-2') ? 'text-white' : ''}`}
                                >
                                    {post.title}
                                </h2>
                                <p class={`text-sm line-clamp-3 italic ${post.size?.includes('row-span-2') ? 'text-white/80' : 'text-base-content/70'}`}>
                                    {post.excerpt}
                                </p>
                                <div class={`mt-4 pt-4 border-t flex items-center justify-between ${post.size?.includes('row-span-2') ? 'border-white/20' : 'border-base-200'}`}>
                                    <div class="flex items-center gap-2">
                                        <div class="w-6 h-6 rounded-full overflow-hidden bg-primary/10 flex items-center justify-center ring-1 ring-base-200">
                                            {post.author?.foto ? (
                                                <img
                                                    src={post.author.foto}
                                                    alt={post.author.name}
                                                    loading="lazy"
                                                    class="w-full h-full object-cover"
                                                />
                                            ) : (
                                                <span class="text-[10px] font-bold text-primary">
                                                    {post.author?.name?.charAt(
                                                        0,
                                                    )}
                                                </span>
                                            )}
                                        </div>
                                        <span class={`text-xs font-semibold ${post.size?.includes('row-span-2') ? 'text-white/80' : 'text-base-content/70'}`}>
                                            {post.author?.name || "Viajero"}
                                        </span>
                                    </div>
                                    <div class={`flex items-center gap-3 text-[10px] font-medium ${post.size?.includes('row-span-2') ? 'text-white/40' : 'text-base-content/40'}`}>
                                        <span>
                                            {new Date(
                                                post.publishedAt ||
                                                    post.createdAt ||
                                                    new Date(),
                                            ).toLocaleDateString("es-DO", {
                                                day: "numeric",
                                                month: "short",
                                            })}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </article>
                        )})
                    }
                </section>
            ) : (
                <div class="flex flex-col items-center justify-center py-20 px-4 text-center bg-[#FCFBF9] rounded-3xl border border-base-200 mt-2 mb-8" transition:name="blog-empty-state">
                    <div class="bg-primary/5 p-6 rounded-full inline-flex items-center justify-center mb-6">
                        <svg class="w-12 h-12 text-primary/60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                        </svg>
                    </div>
                    <h3 class="text-2xl font-heading font-extrabold text-base-content mb-2">Aún no hay historias aquí</h3>
                    <p class="text-base-content/60 max-w-md mx-auto mb-6 text-lg">Parece que no encontramos ninguna publicación bajo esta categoría. ¡Anímate a ser el primero en compartir tu aventura!</p>
                    {isLoggedIn ? (
                        <a transition:name="blog-empty-state" href="/blog/nuevo" class="btn btn-primary rounded-full shadow-lg">
                            Comparte tu historia
                        </a>
                    ) : (
                        <a href="/login?redirect=/blog/nuevo" class="btn btn-primary rounded-full shadow-lg">
                            Inicia sesión para compartir
                        </a>
                    )}
                </div>
            )}

            <Pagination 
                currentPage={meta.page} 
                totalPages={meta.totalPages} 
                baseUrl="/blog" 
                searchParams={Astro.url.searchParams}
            />

            <div class="hidden" id="ssr-debug">
                DEBUG -- Category: {currentCategory} | Success: {
                    success ? "true" : "false"
                } | Posts length: {posts?.length} | Message: {message} | Page: {meta.page} / {meta.totalPages}
            </div>
        </div>
    </main>
</Layout>
